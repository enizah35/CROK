# Copier dans scripts/.env.local (jamais versionné) pour pnpm recipes:push.
# Clé service_role : elle contourne la RLS. Ne JAMAIS la préfixer EXPO_PUBLIC_, ne jamais la commiter.
# Supabase local : `supabase status` affiche l'URL et la clé service_role.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
