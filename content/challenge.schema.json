{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "week_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Lundi de la semaine du défi (AAAA-MM-JJ)."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "eligible_recipes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Slugs des recettes qui valident le défi (R-27)."
    },
    "badge_code": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Code du badge attribué (ex. roi_des_pates)."
    },
    "bonus_xp": {
      "default": 50,
      "description": "Bonus d’XP du défi réussi (50 par défaut, R-14).",
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    }
  },
  "required": [
    "week_start",
    "title",
    "description",
    "eligible_recipes",
    "badge_code"
  ],
  "additionalProperties": false,
  "title": "Défi de la semaine CROK"
}
